# ---------------------------------------------------------------------------
# Blueprint AI — Backend environment configuration
# Copy to `.env` and fill in real values. None of these are required for the
# app to *import*/*boot* (DB connection is lazy), but they are required at
# runtime for DB access and auth verification.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (Supabase Postgres connection string).
# Use the Supabase "Connection string" (Session/Transaction pooler) value.
# Example: postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/blueprint

# Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Legacy HS256 JWT secret (Supabase Dashboard -> Settings -> API -> JWT Secret).
# Used to verify Supabase-issued access tokens signed with HS256.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Expected audience for Supabase access tokens (default below is correct).
SUPABASE_JWT_AUD=authenticated
# Optional: JWKS endpoint for RS256/ES256 (newer asymmetric signing keys).
# If set, RS/ES tokens are verified via JWKS instead of the shared secret.
# Defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json when left blank.
SUPABASE_JWKS_URL=

# CORS — allowed frontend origins, as a JSON array.
# (pydantic-settings JSON-decodes list fields from .env, so use JSON, not CSV.)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://blueprint-ai-rust.vercel.app"]

# AI provider — ``auto`` (OpenRouter if key set, else Gemini), ``openrouter``, or ``gemini``.
# When no key is configured the pipeline uses deterministic stub output.
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT=45
# Set true for fast local demos (~15s). Set false to call OpenRouter/Gemini (slow on free tier).
LLM_STUB_MODE=false

# OpenRouter (recommended free tier) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Primary model (Mistral 7B free). Falls back to OPENROUTER_MODEL_FAST when unavailable.
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_FAST=openai/gpt-oss-20b:free
# Note: mistral-7b-instruct:free may show "No endpoints" on OpenRouter — use MODEL_FAST until restored.
# Other free options (must end with :free):
#   openai/gpt-oss-20b:free
#   google/gemma-4-31b-it:free
#   openrouter/free
# Browse: https://openrouter.ai/models?q=free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://your-frontend.vercel.app

# Google Gemini direct (optional fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_REQUEST_TIMEOUT=90

# Auth bypass for local development WITHOUT a Supabase project.
# When true, all requests resolve to a fake dev user (NEVER enable in prod).
AUTH_DEV_BYPASS=false
