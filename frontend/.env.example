# ─────────────────────────────────────────────────────────────
# Blueprint AI — Frontend environment variables
# Copy to `.env.local` and fill in. All client vars MUST be prefixed with VITE_.
# Phase 2 runs entirely on mock data, so none of these are required yet.
# A later integration agent (Phase 4) wires these up.
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend (REST API, /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project URL + anon (public) key for Supabase Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: SSE endpoint override for the live execution stream.
# Defaults to `${VITE_API_BASE_URL}/executions/{run_id}/stream`.
# VITE_SSE_BASE_URL=

# Optional: toggle the mock data layer off once the backend is live.
# When "true" (default for Phase 2), the app serves mock data with no network calls.
VITE_USE_MOCKS=true

# Production app URL for OAuth redirects (set on Vercel — must match Supabase Site URL).
# VITE_SITE_URL=https://blueprint-ai-rust.vercel.app
